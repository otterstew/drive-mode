<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night: warm charcoal, for driving in the dark. -->
    <color name="ground">#24221F</color>
    <color name="paper">#2E2B27</color>
    <color name="ink">#E9E6E0</color>
    <color name="ochre">#C99A4A</color>
    <style name="Drive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:colorAccent">@color/ochre</item>
    </style>
</resources>
